APP_NAME=APICS
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apics
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Set false to disable all outbound emails (in-app notifications still work)
MAIL_ENABLED=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# APICS — NEVER enable demo quick-login outside local development
APICS_DEMO_QUICK_LOGIN=false

# Optional extra CORS origins (comma-separated). APP_URL is always included.
# CORS_ALLOWED_ORIGINS=https://ocbo.example.gov.ph

# Public / GWTD contact chrome (override when City Hall ICT confirms)
APICS_AGENCY_NAME="Office of the City Building Official"
APICS_LGU_NAME="City Government of San Fernando, Pampanga"
APICS_OFFICE_ADDRESS="City Hall Complex, City of San Fernando, Pampanga, Philippines"
APICS_OFFICE_PHONE="(045) 961-XXXX"
APICS_OFFICE_EMAIL="ocbo@cityofsanfernando.gov.ph"
APICS_OFFICE_HOURS="Monday–Friday, 8:00 AM – 5:00 PM (except holidays)"

SANCTUM_EXPIRATION=10080
